# ============================================================================
# MeroCoffee Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Core Django Settings
# ----------------------------------------------------------------------------

# DEBUG: Enable debug mode (MUST be False in production)
# Default: False
DEBUG=True

# DJANGO_SECRET_KEY: Secret key for cryptographic signing (REQUIRED in production)
# Generate a new key using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# SECURITY WARNING: Keep this secret! Never commit the actual key to version control
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production

# DJANGO_ALLOWED_HOSTS: Comma-separated list of allowed host/domain names (REQUIRED in production)
# Example: example.com,www.example.com,api.example.com
# Default: localhost,127.0.0.1,0.0.0.0 (in DEBUG mode only)
DJANGO_ALLOWED_HOSTS=

# SITE_BASE_URL: Base URL of your site (used for generating absolute URLs in emails, etc.)
# Production example: https://merocoffee.com
# Default: http://127.0.0.1:8000/
SITE_BASE_URL=http://127.0.0.1:8000/

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# DATABASE_URL: Database connection URL (optional, defaults to SQLite)
# SQLite (development): sqlite:///db.sqlite3
# PostgreSQL (production): postgresql://username:password@localhost:5432/database_name
# PostgreSQL with SSL: postgresql://username:password@localhost:5432/database_name?sslmode=require
#
# Example for production:
# DATABASE_URL=postgresql://merocoffee_user:secure_password@localhost:5432/merocoffee_db
#
# Leave commented to use SQLite (development only)
# DATABASE_URL=

# ----------------------------------------------------------------------------
# Security & Authentication
# ----------------------------------------------------------------------------

# TOKEN_SALT: Salt for email verification tokens (REQUIRED in production)
# Generate using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
TOKEN_SALT=your-random-token-salt-key-change-this

# TOKEN_EXPIRATION_HOURS: Hours until email verification tokens expire
# Default: 48
TOKEN_EXPIRATION_HOURS=48

# SECURE_SSL_REDIRECT: Force HTTPS redirect (production only, when DEBUG=False)
# Set to True in production when SSL/TLS is configured
# Default: True (when DEBUG=False)
# SECURE_SSL_REDIRECT=True

# ----------------------------------------------------------------------------
# Email Configuration
# ----------------------------------------------------------------------------

# SMTP_URL: Email backend configuration URL
#
# Console backend (development - prints emails to console):
# SMTP_URL=console://user:password@localhost?_default_from_email=noreply@localhost
#
# SMTP backend (production):
# SMTP_URL=smtp://username:password@smtp.gmail.com:587?_default_from_email=noreply@merocoffee.com
# SMTP_URL=smtp+tls://username:password@smtp.sendgrid.net:587?_default_from_email=noreply@merocoffee.com
#
# For Gmail with app password:
# SMTP_URL=smtp+tls://your-email@gmail.com:your-app-password@smtp.gmail.com:587?_default_from_email=noreply@merocoffee.com
#
# Default: console backend
SMTP_URL=console://user:password@localhost?_default_from_email=noreply@localhost

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

# LOG_DIR: Directory for application logs
# Default: logs
LOG_DIR=logs

# ============================================================================
# Production Deployment Checklist
# ============================================================================
# Before deploying to production, ensure you:
#
# 1. Set DEBUG=False
# 2. Generate and set a unique DJANGO_SECRET_KEY
# 3. Generate and set a unique TOKEN_SALT
# 4. Configure DJANGO_ALLOWED_HOSTS with your domain(s)
# 5. Set up PostgreSQL and configure DATABASE_URL
# 6. Configure SMTP_URL with real email provider
# 7. Set SITE_BASE_URL to your production domain (with https://)
# 8. Ensure SECURE_SSL_REDIRECT=True (or leave commented for auto-enable)
# 9. Run: python manage.py check --deploy
# 10. Run: python manage.py migrate
# 11. Run: python manage.py collectstatic
#
# See DEPLOYMENT.md for detailed deployment instructions
# ============================================================================

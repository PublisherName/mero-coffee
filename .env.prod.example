# ============================================================================
# MeroCoffee Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Core Django Settings
# ----------------------------------------------------------------------------
# PROJECT_NAME: Name of the project (used for container names)
#
PROJECT_NAME=merocoffee

# SITE_NAME: Name of the site
# Default: MeroCoffee
#
# SITE_NAME

# ============================================================================

# PROJECT_VERSION: Version of the project (used for image tags)
#
PROJECT_VERSION=latest
# ============================================================================

# SERVER_ENVIRONMENT: Set the server environment (development, testing, staging, production)
# Default: development
#
SERVER_ENVIRONMENT=production
# ============================================================================

# DJANGO_SECRET_KEY: Secret key for cryptographic signing (REQUIRED in production)
# Generate a new key using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# SECURITY WARNING: Keep this secret! Never commit the actual key to version control
#
# DJANGO_SECRET_KEY=
# ============================================================================

# DJANGO_ALLOWED_HOSTS: Comma-separated list of allowed host/domain names (REQUIRED in production)
# Example: example.com,www.example.com,api.example.com
# Default: localhost,127.0.0.1,0.0.0.0 (in DEBUG mode only)
#
# DJANGO_ALLOWED_HOSTS=
# ============================================================================

# ALLOWED_CIDR_NETS: Comma-separated list of CIDR blocks for internal traffic (e.g., VPC subnet, ALB health checks)
# Use with django-allow-cidr middleware for ALLOWED_HOSTS IP range support
# Example: 10.0.0.0/16,172.16.0.0/12 (your VPC CIDR from Terraform module.vpc.cidr_block)
# Default: empty (no CIDR validation)
#
# Keep this commented to disable CIDR checks
# ALLOWED_CIDR_NETS=10.0.0.0/16
# ============================================================================

# SITE_BASE_URL: Base URL of your site (used for generating absolute URLs in emails, etc.)
# Production example: https://merocoffee.com
# Default: http://127.0.0.1:8000/
#
# SITE_BASE_URL=
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# DATABASE_URL: Database connection URL (optional)
# Default: sqlite:///db.sqlite3 (file-based SQLite - data persists between runs)
# File-based SQLite (data persists between runs):
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name?sslmode=require
#
# Leave commented to use in-memory SQLite (default)
# DATABASE_URL=
# ============================================================================

# Cache Configuration
# ----------------------------------------------------------------------------
# Default: redis://localhost:6379/0
# Redis: redis://USER:PASSWORD@HOST:PORT/DB
# Example: redis://localhost:6379/0?ssl_cert_reqs=required
#
# CACHE_URL=
# ============================================================================

# RateLimit Configuration
# Default: 3/30m
#
# Leave commented to use 3/30m rate
#
# RATELIMIT_RATE=
# ============================================================================

# Security & Authentication
# Default get_random_secret_key()
# TOKEN_SALT: Salt for email verification tokens (REQUIRED in production)
# Generate using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
# TOKEN_SALT=
# ============================================================================

# TOKEN_EXPIRATION_HOURS: Hours until email verification tokens expire
# Default: 48
#
# TOKEN_EXPIRATION_HOURS=48
# ============================================================================

# Email Configuration
# SMTP_URL: Email backend configuration URL
# Console backend (development - prints emails to console):
# SMTP_URL=console://user:password@localhost?_default_from_email=noreply@localhost
# SMTP_URL=smtp://username:password@smtp.gmail.com:587?tls=true&_default_from_email=noreply@merocoffee.com
# SMTP_URL=smtp+tls://username:password@smtp.sendgrid.net:587?_default_from_email=noreply@merocoffee.com
# SMTP_URL=smtp+tls://your-email@gmail.com:your-app-password@smtp.gmail.com:587?_default_from_email=noreply@merocoffee.com
# Default: console backend
#
# SMTP_URL=
# ============================================================================

# LOG_DIR: Directory for application logs
# Default: logs
#
# LOG_DIR=logs
# ============================================================================

# ----------------------------------------------------------------------------
# Cloudflare Turnstile Configuration
# ----------------------------------------------------------------------------

# TURNSTILE_SITEKEY: Cloudflare Turnstile site key (get from Cloudflare dashboard)
# Default: 1x00000000000000000000AA (test key that always passes)
# Test keys (for development):
# Always passes: 1x00000000000000000000AA
# Always fails: 2x00000000000000000000AB
# Forces interactive challenge: 3x00000000000000000000FF
# Production: Get your keys from https://dash.cloudflare.com/?to=/:account/turnstile
#
# TURNSTILE_SITEKEY=

# TURNSTILE_SECRET: Cloudflare Turnstile secret key (get from Cloudflare dashboard)
# Default: 1x0000000000000000000000000000000AA (test key that always passes)
#
# TURNSTILE_SECRET=

# ----------------------------------------------------------------------------
# Celery Configuration
# ----------------------------------------------------------------------------

# Enable Celery for async emails (true=async, false=sync)
# Default: False
#
# USE_CELERY=True

# Celery result backend
# Default: django-db
#
# CELERY_RESULT_BACKEND=

# ----------------------------------------------------------------------------
# Minimum Donation Amount
# ----------------------------------------------------------------------------

# MINIMUM_DONATION_AMOUNT: Minimum donation amount
# Default: 100
# Uncomment and set if MINIMUM_DONATION_AMOUNT
# MINIMUM_DONATION_AMOUNT=100

# ----------------------------------------------------------------------------
# Minimum Withdrawl Amount
# ----------------------------------------------------------------------------

# MIN_WITHDRAWAL_AMOUNT: Minimum withdrawl amount
# Default: 100
# Uncomment and set if MIN_WITHDRAWAL_AMOUNT
# MIN_WITHDRAWAL_AMOUNT=100

# ----------------------------------------------------------------------------
# Sentry Configuration
# ----------------------------------------------------------------------------

# ENABLE_SENTRY: Enable Sentry error monitoring (true/false)
# Default: false
#
# ENABLE_SENTRY=

# SENTRY_DSN: Sentry DSN (Data Source Name) for error reporting
# Get from your Sentry project settings
#
# SENTRY_DSN=

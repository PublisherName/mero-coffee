server {
    listen 80;
    server_name coffee.subashghimire.info.np;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name coffee.subashghimire.info.np;

    ssl_certificate /etc/letsencrypt/live/coffee.subashghimire.info.np/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coffee.subashghimire.info.np/privkey.pem;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml;

    # Static files with caching
    location = /favicon.ico {
        access_log off;
        log_not_found off;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /static/ {
        alias /home/ubuntu/django/MeroCoffee/public/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Media files
    location /media/ {
        alias /home/ubuntu/django/MeroCoffee/media/;
        expires 1M;
        add_header Cache-Control "public";
    }

    # Main application
    location / {
        proxy_pass http://unix:/run/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
}

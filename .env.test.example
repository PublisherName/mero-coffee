# ============================================================================
# MeroCoffee Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Core Django Settings
# ----------------------------------------------------------------------------
# PROJECT_NAME: Name of the project (used for container names)
PROJECT_NAME=merocoffee

# SERVER_ENVIRONMENT: Set the server environment (development, testing, staging, production)
# Default: development
SERVER_ENVIRONMENT=testing

# DJANGO_SECRET_KEY: Secret key for cryptographic signing (REQUIRED in production)
# Generate a new key using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# SECURITY WARNING: Keep this secret! Never commit the actual key to version control
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production

# DJANGO_ALLOWED_HOSTS: Comma-separated list of allowed host/domain names (REQUIRED in production)
# Example: example.com,www.example.com,api.example.com
# Default: localhost,127.0.0.1,0.0.0.0 (in DEBUG mode only)
DJANGO_ALLOWED_HOSTS=

# SITE_BASE_URL: Base URL of your site (used for generating absolute URLs in emails, etc.)
# Production example: https://merocoffee.com
# Default: http://127.0.0.1:8000/
SITE_BASE_URL=http://127.0.0.1:8000/

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------

# DATABASE_URL: Database connection URL (optional)
# Default: sqlite:///db.sqlite3 (file-based SQLite - data persists between runs)
# File-based SQLite (data persists between runs):
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name?sslmode=require
#
# Leave commented to use in-memory SQLite (default)
# DATABASE_URL=

# ----------------------------------------------------------------------------
# Cache Configuration
# ----------------------------------------------------------------------------
# Default: redis://localhost:6379/0
# Redis: redis://USER:PASSWORD@HOST:PORT/DB
# Example: redis://localhost:6379/0
#
# Leave commented to use dummy cache
# CACHE_URL=

# ----------------------------------------------------------------------------
# RateLimit Configuration
# ----------------------------------------------------------------------------
# Default: 3/30m
#
# Leave commented to use 3/30m rate
# RATELIMIT_RATE=3/30m

# ----------------------------------------------------------------------------
# Security & Authentication
# ----------------------------------------------------------------------------

# TOKEN_SALT: Salt for email verification tokens (REQUIRED in production)
# Generate using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# TOKEN_SALT=

# TOKEN_EXPIRATION_HOURS: Hours until email verification tokens expire
# Default: 48
# TOKEN_EXPIRATION_HOURS=

# ----------------------------------------------------------------------------
# Email Configuration
# ----------------------------------------------------------------------------

# SMTP_URL: Email backend configuration URL
#
# Console backend (development - prints emails to console):
# SMTP_URL=smtp://username:password@smtp.gmail.com:587?tls=true&_default_from_email=noreply@merocoffee.com
#
# SMTP backend (production):
# SMTP_URL=smtp://username:password@smtp.gmail.com:587?_default_from_email=noreply@merocoffee.com
# SMTP_URL=smtp+tls://username:password@smtp.sendgrid.net:587?_default_from_email=noreply@merocoffee.com
#
# For Gmail with app password:
# SMTP_URL=smtp+tls://your-email@gmail.com:your-app-password@smtp.gmail.com:587?_default_from_email=noreply@merocoffee.com
#
# Default: console backend
SMTP_URL=console://user:password@localhost?_default_from_email=noreply@localhost

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

# LOG_DIR: Directory for application logs
# Default: logs
LOG_DIR=logs

# ----------------------------------------------------------------------------
# Tailwind CSS Configuration
# ----------------------------------------------------------------------------

# NPM_BIN_PATH: Path to npm binary (used by django-tailwind)
# Default: /usr/bin/npm
# Uncomment and set if npm is installed in a non-standard location
# NPM_BIN_PATH=/usr/bin/npm
